{
  "brand": {
    "name": "Flood Watch",
    "descriptor": "Klang Valley",
    "tagline": "Every river in the Klang Valley. Live."
  },
  "color": {
    "brand": {
      "volt": "#0038FF",
      "voltLight": "#8AA4FF",
      "water": "#5B86FF",
      "shallow": "#E6ECFF",
      "ink": "#0B0D10",
      "paper": "#FFFFFF",
      "night": "#0A1233"
    },
    "app": {
      "light": {
        "accent": "#0038FF",
        "onAccent": "#FFFFFF",
        "surface": "#FFFFFF",
        "onSurface": "#1F1F1F",
        "muted": "#5F6368",
        "outline": "#DADCE0",
        "hover": "#F1F3F4",
        "themeColor": "#FFFFFF",
        "navIndicator": "#1F1F1F",
        "onNavIndicator": "#FFFFFF",
        "accentFill": "#0038FF",
        "onAccentFill": "#FFFFFF"
      },
      "dark": {
        "accent": "#8AA4FF",
        "onAccent": "#202124",
        "surface": "#202124",
        "onSurface": "#E8EAED",
        "muted": "#9AA0A6",
        "outline": "#3C4043",
        "hover": "#303134",
        "themeColor": "#202124",
        "navIndicator": "#E8EAED",
        "onNavIndicator": "#202124",
        "accentFill": "#2F5BFF",
        "onAccentFill": "#FFFFFF"
      }
    },
    "reserved": {
      "note": "Status and sensor-kind colours stay in css/base.css and are never brand colours.",
      "status": [
        "--s-normal",
        "--s-alert",
        "--s-warning",
        "--s-danger",
        "--s-none"
      ],
      "kinds": [
        "--k-river",
        "--k-rainfall",
        "--k-siren",
        "--k-gauge",
        "--k-camera",
        "--k-mast"
      ]
    },
    "kinds": {
      "rule": "OKLCh, one chroma 0.150 (was 0.119), hues 238/298/358/58/118/178, L paper 0.620 / pin 0.690 / dark 0.760",
      "paper": {
        "river": "#0290ce",
        "rainfall": "#926fd4",
        "siren": "#cb5a86",
        "gauge": "#c66b01",
        "mast": "#7f9101",
        "camera": "#019c86",
        "weather": "#0497a7",
        "source": "#b561b3",
        "notice": "#5f80e0"
      },
      "pin": {
        "river": "#11a6ec",
        "rainfall": "#a784eb",
        "siren": "#e3709b",
        "gauge": "#df8028",
        "mast": "#94a722",
        "camera": "#00b49b",
        "weather": "#05afc1",
        "source": "#cc77ca",
        "notice": "#7495f8"
      },
      "dark": {
        "river": "#4abdfe",
        "rainfall": "#bc9cff",
        "siren": "#fb85b1",
        "gauge": "#f79643",
        "mast": "#a9bd40",
        "camera": "#08cdb1",
        "weather": "#07c7dc",
        "source": "#e48de1",
        "notice": "#90aeff"
      }
    }
  },
  "contrast": {
    "volt on white": 6.98,
    "volt on #F1F3F4": 6.27,
    "white on volt": 6.98,
    "voltLight on #202124": 6.77,
    "voltLight on #303134": 5.47,
    "white on ink indicator": 16.48,
    "#202124 on light indicator": 13.36
  },
  "font": {
    "display": {
      "family": "Archivo",
      "width": 125,
      "weight": 900,
      "use": "wordmark, splash, headings in marketing, share cards"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weight": 500,
      "use": "readings, timestamps, the KLANG VALLEY descriptor"
    },
    "ui": {
      "family": "Roboto",
      "use": "all app UI text (unchanged, M3 typescale)"
    }
  },
  "logo": {
    "clearSpace": "1/3 of the mark height on every side",
    "minMark": "16 px",
    "minLockup": "120 px wide",
    "iconCornerRadius": "22.37% (iOS squircle approximation)"
  },
  "icon": {
    "glyphInTile": "72% of tile width",
    "androidForegroundScale": 0.68,
    "maskableScale": 0.84,
    "manifestBackgroundColor": "#0038FF"
  },
  "decisions": {
    "navIndicator": "ink (inverse surface)",
    "readingsMono": "ships with the rebrand",
    "androidLaunchScreen": "#0038FF",
    "kindColours": "vivid, chroma 0.150",
    "buttons": "bold"
  },
  "button": {
    "style": "bold",
    "minHeight": "48px",
    "padding": "0 24px",
    "radius": "12px",
    "font": "Archivo Expanded 800 13px, width 125, uppercase, tracking .02em",
    "primary": {
      "light": [
        "#0038FF",
        "#FFFFFF"
      ],
      "dark": [
        "#8AA4FF",
        "#202124"
      ]
    },
    "secondary": {
      "light": [
        "#1F1F1F",
        "#FFFFFF"
      ],
      "dark": [
        "#E8EAED",
        "#202124"
      ]
    },
    "text": "on-surface, underlined",
    "rules": [
      "one primary per surface",
      "never a status colour",
      "labels about 2 words / 14 characters",
      "stack full-width below 600px except dialog footers",
      "icon buttons, chips, menus, list rows unchanged"
    ]
  }
}